{
  "name": "@govprov/gateway",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "GovReplay deterministic pre-action governance gateway.",
  "bin": {
    "govreplay-gateway": "./bin/govreplay-gateway.mjs"
  },
  "scripts": {
    "check": "node bin/govreplay-gateway.mjs check",
    "example:allow": "node --experimental-strip-types src/example-agent-client.ts --request fixtures/s1-runbook-allow.request.json --out ../../runs/gateway-example/allow",
    "example:deny": "node --experimental-strip-types src/example-agent-client.ts --request fixtures/s1-runbook-deny.request.json --out ../../runs/gateway-example/deny",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "engines": {
    "node": ">=22.6"
  }
}
