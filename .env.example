# Copy to .env or set in your shell before Besu dev deployment.
# Keep the copied file ignored and do not commit private keys.
GOVPROV_DEV_DEPLOYER_PRIVATE_KEY="" # Set locally; never commit a real key.
GOVPROV_TEMPORAL_ACTOR_PRIVATE_KEY="" # Use a distinct disposable local key.
# Optional administrator address for a newly generated development genesis.
# Existing chain data is never re-funded by this setting.
GOVPROV_DEV_ADMIN_ADDRESS="" # Public address only, matching the local wallet.
