{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://govprov.dev/schemas/attestations/deployment.schema.json",
  "title": "DeploymentAttestation",
  "allOf": [
    { "$ref": "./common.schema.json" },
    {
      "type": "object",
      "properties": {
        "attestation_type": { "const": "DeploymentAttestation" },
        "predicate_type": { "const": "https://govprov.dev/predicate/deployment/v1" },
        "predicate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["deployment_id", "environment", "artifact_hash", "approval_hash"],
          "properties": {
            "deployment_id": { "type": "string" },
            "environment": { "type": "string" },
            "artifact_hash": { "$ref": "./common.schema.json#/$defs/bytes32" },
            "approval_hash": { "$ref": "./common.schema.json#/$defs/bytes32" }
          }
        }
      }
    }
  ]
}
