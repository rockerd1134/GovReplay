{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://govprov.dev/schemas/attestations/evidence_bundle.schema.json",
  "title": "EvidenceBundleAttestation",
  "allOf": [
    { "$ref": "./common.schema.json" },
    {
      "type": "object",
      "properties": {
        "attestation_type": { "const": "EvidenceBundleAttestation" },
        "predicate_type": { "const": "https://govprov.dev/predicate/evidence-bundle/v1" },
        "predicate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidence_count", "evidence"],
          "properties": {
            "evidence_count": { "type": "string", "pattern": "^[0-9]+$" },
            "evidence": { "type": "array", "items": { "type": "object" } }
          }
        }
      }
    }
  ]
}
