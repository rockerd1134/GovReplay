{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://govprov.dev/schemas/attestations/ledger_anchor.schema.json",
  "title": "LedgerAnchorAttestation",
  "allOf": [
    { "$ref": "./common.schema.json" },
    {
      "type": "object",
      "properties": {
        "attestation_type": { "const": "LedgerAnchorAttestation" },
        "predicate_type": { "const": "https://govprov.dev/predicate/ledger-anchor/v1" },
        "predicate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["chain_id", "transaction_hash", "contract_address", "anchored_hash"],
          "properties": {
            "chain_id": { "type": "string", "pattern": "^[0-9]+$" },
            "transaction_hash": { "$ref": "./common.schema.json#/$defs/bytes32" },
            "contract_address": { "$ref": "./common.schema.json#/$defs/ethereumAddress" },
            "anchored_hash": { "$ref": "./common.schema.json#/$defs/bytes32" }
          }
        }
      }
    }
  ]
}
